import React, {useEffect, useMemo, useState} from 'react';
import {createRoot} from 'react-dom/client';
import {LineChart,Line,BarChart,Bar,XAxis,YAxis,CartesianGrid,Tooltip,ResponsiveContainer,Legend,AreaChart,Area} from 'recharts';
import {MapContainer,TileLayer,Polyline,CircleMarker,Popup,useMap} from 'react-leaflet';
import 'leaflet/dist/leaflet.css';
import './styles.css';

const API='http://localhost:5000/api';
const DAY_NAMES=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];

function FitRoutes({routes}){const map=useMap();useEffect(()=>{if(routes?.length){const pts=routes.flatMap(r=>r.path||[]);if(pts.length)map.fitBounds(pts,{padding:[25,25]});}},[routes,map]);return null}
function Stat({label,value,sub}){return <div className="stat"><div className="stat-label">{label}</div><div className="stat-value">{value}</div><div className="stat-sub">{sub}</div></div>}
function Pill({children,type=''}){return <span className={`pill ${type.toLowerCase()}`}>{children}</span>}
function App(){
 const [routes,setRoutes]=useState([]),[eda,setEda]=useState(null),[metrics,setMetrics]=useState(null),[prediction,setPrediction]=useState(null),[loading,setLoading]=useState(false),[file,setFile]=useState(null),[message,setMessage]=useState('');
 const [origin,setOrigin]=useState('Bachupally'),[destination,setDestination]=useState('HITEC City'),[hour,setHour]=useState(8),[day,setDay]=useState(0),[vehicles,setVehicles]=useState(900),[rain,setRain]=useState(0),[temp,setTemp]=useState(28),[incident,setIncident]=useState(0),[event,setEvent]=useState(0),[holiday,setHoliday]=useState(0);
 useEffect(()=>{Promise.all([fetch(API+'/routes').then(r=>r.json()),fetch(API+'/eda').then(r=>r.json()),fetch(API+'/metrics').then(r=>r.json())]).then(([r,e,m])=>{setRoutes(r.routes||[]);setEda(e);setMetrics(m);}).catch(()=>setMessage('Start the Flask backend on port 5000 to load the live model dashboard.'));},[]);
 const pairs=useMemo(()=>{const seen=new Set();return routes.filter(r=>{const k=r.origin+'|'+r.destination;if(seen.has(k))return false;seen.add(k);return true;})},[routes]);
 useEffect(()=>{if(!pairs.find(p=>p.origin===origin&&p.destination===destination)&&pairs[0]){setOrigin(pairs[0].origin);setDestination(pairs[0].destination)}},[pairs]);
 const submitPrediction=async()=>{setLoading(true);setMessage('Running both models across the route alternatives…');try{const r=await fetch(API+'/predict',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({origin,destination,hour,day_of_week:day,vehicle_count:vehicles,rainfall_mm:rain,temperature_c:temp,incident_level:incident,event_score:event,holiday})});const data=await r.json();if(!r.ok)throw new Error(data.error||'Prediction failed');setPrediction(data);setMessage('Prediction complete — routes ranked by ensemble predicted travel time.')}catch(e){setMessage(e.message)}finally{setLoading(false)}};
 const upload=async()=>{if(!file)return;setLoading(true);setMessage('Uploading dataset and retraining Random Forest + Gradient Boosting…');const fd=new FormData();fd.append('file',file);try{const r=await fetch(API+'/train',{method:'POST',body:fd});const d=await r.json();if(!r.ok)throw new Error(d.error);setMessage(`Retrained on ${d.rows.toLocaleString()} rows in ${d.train_seconds.toFixed(2)}s.`);const [e,m]=await Promise.all([fetch(API+'/eda').then(x=>x.json()),fetch(API+'/metrics').then(x=>x.json())]);setEda(e);setMetrics(m);await submitPrediction();}catch(e){setMessage(e.message)}finally{setLoading(false)}};
 const mapRoutes=prediction?.routes||[]; const selected=prediction?.selected_route;
 return <div className="app">
  <header className="topbar"><div className="brand"><div className="logo">TL</div><div><div className="brand-name">TrafficLens AI</div><div className="brand-sub">Congestion intelligence lab</div></div></div><div className="header-meta"><span className="live-dot"></span> ML pipeline online <span className="divider"></span> Team 2</div></header>
  <main>
   <section className="hero"><div><div className="eyebrow">MACHINE LEARNING • SMART MOBILITY</div><h1>Traffic Congestion Level<br/><span>Prediction Engine</span></h1><p>Random Forest + Gradient-Boosted Trees turn traffic conditions into congestion levels, travel-time estimates and route comparisons.</p><div className="teamline"><b>P. Laxman Reddy</b> · 2520030097 <span>and</span> <b>R. Varshith Reddy</b> · 2520030250</div></div><div className="hero-card"><div className="mini-label">PROJECT TARGET</div><div className="target">Low <i>·</i> Medium <i>·</i> High</div><div className="mini-note">Supervised multi-class classification + travel-time regression</div></div></section>
   {message&&<div className="notice">{message}</div>}
   <section className="stats-grid">
    <Stat label="Dataset rows" value={metrics?.rows?.toLocaleString()||'—'} sub="project-ready traffic observations"/>
    <Stat label="Input features" value={metrics?.features?.length||'—'} sub="after preprocessing"/>
    <Stat label="Models" value="2 + 2" sub="classification + travel-time regression"/>
    <Stat label="Training time" value={metrics?`${metrics.train_seconds.toFixed(2)}s`:'—'} sub="on current machine"/>
   </section>
   <section className="workspace">
    <div className="panel controls"><div className="panel-head"><div><div className="section-kicker">01 · ROUTE LAB</div><h2>Find the fastest model-predicted route</h2></div><Pill>Live inference</Pill></div>
      <div className="field-grid"><label>Origin<select value={origin} onChange={e=>setOrigin(e.target.value)}>{pairs.map(p=><option key={p.origin}>{p.origin}</option>)}</select></label><label>Destination<select value={destination} onChange={e=>setDestination(e.target.value)}>{pairs.filter(p=>p.origin===origin).map(p=><option key={p.destination}>{p.destination}</option>)}</select></label><label>Hour <span>{String(hour).padStart(2,'0')}:00</span><input type="range" min="0" max="23" value={hour} onChange={e=>setHour(+e.target.value)}/></label><label>Day<select value={day} onChange={e=>setDay(+e.target.value)}>{DAY_NAMES.map((d,i)=><option value={i} key={d}>{d}</option>)}</select></label><label>Vehicles<input type="number" min="50" value={vehicles} onChange={e=>setVehicles(+e.target.value)}/></label><label>Rainfall (mm)<input type="number" min="0" step="0.1" value={rain} onChange={e=>setRain(+e.target.value)}/></label><label>Temperature °C<input type="number" value={temp} onChange={e=>setTemp(+e.target.value)}/></label><label>Incident<select value={incident} onChange={e=>setIncident(+e.target.value)}><option value="0">None</option><option value="1">Minor</option><option value="2">Moderate</option><option value="3">Major</option></select></label><label>Special event<select value={event} onChange={e=>setEvent(+e.target.value)}><option value="0">None</option><option value="1">Low</option><option value="2">Medium</option><option value="3">High</option></select></label><label>Holiday<select value={holiday} onChange={e=>setHoliday(+e.target.value)}><option value="0">No</option><option value="1">Yes</option></select></label></div>
      <button className="primary" onClick={submitPrediction} disabled={loading}>{loading?'Running models…':'Compare routes with Random Forest + Gradient Boosting →'}</button>
      <div className="logic"><span>Route logic</span> each candidate is scored with both models; the selected route is the lowest ensemble travel-time estimate among the available alternatives.</div>
    </div>
    <div className="panel map-panel"><div className="panel-head"><div><div className="section-kicker">02 · ROAD MAP</div><h2>Route geometry & congestion</h2></div><div className="map-legend"><span className="legend-line selected"></span> selected <span className="legend-line"></span> alternatives</div></div><div className="map-wrap"><MapContainer center={[17.45,78.41]} zoom={11} scrollWheelZoom={false}><TileLayer attribution="&copy; OpenStreetMap contributors" url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"/>{mapRoutes.map((r,i)=><Polyline key={r.route_id} positions={r.path} pathOptions={{weight:i===0?7:4,opacity:i===0?0.95:0.55}}><Popup><b>{r.route_id}</b><br/>{r.origin} → {r.destination}<br/>{r.ensemble_travel_time_min} min · {r.ensemble_congestion}</Popup></Polyline>)}{selected?.path?.map((p,i)=><CircleMarker key={i} center={p} radius={3} pathOptions={{fillOpacity:1}}/>)}<FitRoutes routes={mapRoutes}/></MapContainer></div></div>
   </section>
   <section className="results"><div className="section-kicker">03 · MODEL DECISION</div><div className="results-head"><div><h2>Route comparison</h2><p>{selected?`Model-selected route: ${selected.route_id} — lowest predicted travel time.`:'Run an inference to rank the available routes.'}</p></div>{selected&&<div className="selected-badge">✓ {selected.route_id} selected</div>}</div>
    <div className="route-cards">{(prediction?.routes||[]).map((r,i)=><div className={`route-card ${i===0?'winner':''}`} key={r.route_id}><div className="route-top"><div><span className="rank">#{i+1}</span><b>{r.route_id}</b> <Pill type={r.ensemble_congestion}>{r.ensemble_congestion}</Pill></div><span>{r.distance_km} km</span></div><div className="route-title">{r.origin} → {r.destination}</div><div className="model-times"><div><small>Random Forest</small><strong>{r.predictions[0].travel_time_min.toFixed(1)} <em>min</em></strong><Pill type={r.predictions[0].congestion}>{r.predictions[0].congestion}</Pill></div><div><small>Gradient Boosting</small><strong>{r.predictions[1].travel_time_min.toFixed(1)} <em>min</em></strong><Pill type={r.predictions[1].congestion}>{r.predictions[1].congestion}</Pill></div><div><small>Ensemble estimate</small><strong>{r.ensemble_travel_time_min.toFixed(1)} <em>min</em></strong><Pill type={r.ensemble_congestion}>{r.ensemble_congestion}</Pill></div></div><div className="route-foot"><span>{r.road_type}</span><span>{r.predictions[0].travel_time_min>r.predictions[1].travel_time_min?'GB predicts faster':'RF predicts faster'}</span></div></div>)}</div>
   </section>
   <section className="upload panel"><div><div className="section-kicker">04 · DATA PIPELINE</div><h2>Bring your own CSV</h2><p>Upload a replacement dataset with the project schema. The backend validates it, retrains both models and refreshes the EDA dashboard.</p><div className="schema">Required: route_id · distance_km · road_type · lanes · speed_limit_kmh · vehicle_count · avg_speed_kmh · occupancy_pct · rainfall_mm · temperature_c · incident_level · holiday · event_score · travel_time_min · congestion_level · day_of_week · hour · is_weekend</div></div><div className="upload-box"><input type="file" accept=".csv" onChange={e=>setFile(e.target.files[0])}/><div className="file-name">{file?file.name:'Choose traffic CSV'}</div><button className="secondary" onClick={upload} disabled={!file||loading}>Upload & retrain</button></div></section>
   <section className="analytics"><div className="section-kicker">05 · EDA REPORT</div><div className="analytics-grid">
    <div className="panel chart"><h3>Hourly travel-time profile</h3><ResponsiveContainer width="100%" height={260}><AreaChart data={eda?.hourly||[]}><CartesianGrid strokeDasharray="3 3"/><XAxis dataKey="hour"/><YAxis/><Tooltip/><Area type="monotone" dataKey="avg_travel_time" name="Avg travel time (min)" fillOpacity={.12} strokeWidth={2}/></AreaChart></ResponsiveContainer></div>
    <div className="panel chart"><h3>Congestion class balance</h3><ResponsiveContainer width="100%" height={260}><BarChart data={eda?.congestion||[]}><CartesianGrid strokeDasharray="3 3"/><XAxis dataKey="level"/><YAxis/><Tooltip/><Bar dataKey="count" name="records"/></BarChart></ResponsiveContainer></div>
    <div className="panel chart"><h3>Average travel time by route</h3><ResponsiveContainer width="100%" height={300}><BarChart data={(eda?.routes||[]).slice(0,15)} layout="vertical"><CartesianGrid strokeDasharray="3 3"/><XAxis type="number"/><YAxis type="category" dataKey="route_id" width={45}/><Tooltip/><Bar dataKey="avg_time" name="minutes"/></BarChart></ResponsiveContainer></div>
    <div className="panel chart"><h3>Random Forest feature importance</h3><ResponsiveContainer width="100%" height={300}><BarChart data={(eda?.feature_importance||[]).slice(0,10)} layout="vertical"><CartesianGrid strokeDasharray="3 3"/><XAxis type="number"/><YAxis type="category" dataKey="feature" width={125}/><Tooltip/><Bar dataKey="importance" name="importance"/></BarChart></ResponsiveContainer></div>
   </div></section>
   <section className="lower-grid"><div className="panel"><div className="section-kicker">06 · MODEL BENCHMARK</div><h2>Random Forest vs Gradient Boosting</h2><div className="benchmark-table"><div className="thead"><span>Metric</span><span>Random Forest</span><span>Gradient Boosting</span></div>{['accuracy','precision','recall','f1','mae_min','rmse_min','r2'].map(k=><div className="trow" key={k}><span>{k.replace('_min',' (min)').toUpperCase()}</span><span>{metrics?.metrics?.['Random Forest']?.[k]!==undefined?(k.includes('mae')||k.includes('rmse')?metrics.metrics['Random Forest'][k].toFixed(2):(k==='r2'?metrics.metrics['Random Forest'][k].toFixed(3):(metrics.metrics['Random Forest'][k]*100).toFixed(2)+'%')):'—'}</span><span>{metrics?.metrics?.['Gradient Boosting']?.[k]!==undefined?(k.includes('mae')||k.includes('rmse')?metrics.metrics['Gradient Boosting'][k].toFixed(2):(k==='r2'?metrics.metrics['Gradient Boosting'][k].toFixed(3):(metrics.metrics['Gradient Boosting'][k]*100).toFixed(2)+'%')):'—'}</span></div>)}</div></div>
   <div className="panel"><div className="section-kicker">07 · SYLLABUS FIT</div><h2>What this project demonstrates</h2><ul className="checklist"><li><b>EDA & preprocessing</b><span>Pandas/NumPy cleaning, missing-value checks, feature distributions and correlations.</span></li><li><b>Decision-tree foundation</b><span>Tree-based splitting is used as the base learner for ensemble methods.</span></li><li><b>Random Forest</b><span>Bagging + multiple decision trees + feature subsampling.</span></li><li><b>Gradient Boosting</b><span>Sequential trees reduce residual error stage by stage.</span></li><li><b>Evaluation</b><span>Accuracy, precision, recall, F1, MAE, RMSE and R².</span></li><li><b>Deployment</b><span>Python backend + React dashboard + route visualization.</span></li></ul></div></section>
   <footer><span>TrafficLens AI · KL University · Machine Learning [25SC2107E]</span><span>Guided by M. Rani · Section 9</span></footer>
  </main>
 </div>
}
createRoot(document.getElementById('root')).render(<App/>);
